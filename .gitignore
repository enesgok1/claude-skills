# This folder also holds skills installed from other sources (frontend-design,
# ui-ux-pro-max, the claude.ai "synced" folder, ...). Ignore everything and
# whitelist only the skills that belong to this repository.
/*
!/.gitignore
!/.github/
# Copy of ~/.claude/CLAUDE.md (the owner's working standard for all projects)
!/CALISMA-STANDARDI.md
# Lessons learned, by topic (not auto-loaded; the standard points to it)
!/DERSLER.md

!/turkce-arayuz-metni/
!/kvkk-kontrol-listesi/
!/sahip-belgeleri/

# Exception, by the owner's request: the Replica pack (Jake Schincariol, MIT,
# github.com/Jakeschincariol/replica-skill). Off by default in skillOverrides.
!/replica-*/

# Claude Code status line used by ~/.claude/settings.json
!/statusline.mjs
